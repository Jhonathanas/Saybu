# =============================================================================
# Saybu — contoh konfigurasi lokal. Salin ke .env lalu sesuaikan.
# JANGAN commit .env (sudah di-gitignore).
# =============================================================================

# --- umum ---
APP_ENV=development
LOG_LEVEL=debug
TZ=Asia/Jakarta

# --- Postgres ---
POSTGRES_USER=saybu
POSTGRES_PASSWORD=saybu
POSTGRES_DB=saybu
POSTGRES_PORT=5433

# --- Gateway ---
GATEWAY_HTTP_ADDR=:8081
GATEWAY_CORS_ORIGINS=http://localhost:5173
JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Auth ---
AUTH_GRPC_ADDR=:50051
AUTH_ADMIN_ADDR=:9101
AUTH_DB_DSN=postgres://saybu:saybu@localhost:5433/saybu_auth?sslmode=disable

# --- Catalog ---
CATALOG_GRPC_ADDR=:50052
CATALOG_ADMIN_ADDR=:9102
CATALOG_DB_DSN=postgres://saybu:saybu@localhost:5433/saybu_catalog?sslmode=disable

# --- Shipping ---
SHIPPING_GRPC_ADDR=:50053
SHIPPING_ADMIN_ADDR=:9103
SHIPPING_DB_DSN=postgres://saybu:saybu@localhost:5433/saybu_shipping?sslmode=disable

# --- Order ---
ORDER_GRPC_ADDR=:50054
ORDER_ADMIN_ADDR=:9104
ORDER_DB_DSN=postgres://saybu:saybu@localhost:5433/saybu_orders?sslmode=disable
ORDER_EXPIRY=24h
# Interval job penanda pesanan kedaluwarsa (PENDING_PAYMENT lewat expires_at).
ORDER_EXPIRY_SWEEP=1m

# --- Payment ---
PAYMENT_GRPC_ADDR=:50055
PAYMENT_ADMIN_ADDR=:9105
PAYMENT_DB_DSN=postgres://saybu:saybu@localhost:5433/saybu_payments?sslmode=disable

# --- Instruksi transfer manual (ditampilkan di halaman sukses) ---
BANK_NAME="BCA"
BANK_ACCOUNT="1234567890"
BANK_HOLDER="Saybu Buah & Sayur"

# --- Unggahan gambar produk ---
UPLOAD_DIR=./data/uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_BYTES=5242880

# --- Kafka ---
KAFKA_BROKERS=localhost:29092
KAFKA_CONSUMER_GROUP_PREFIX=saybu

# --- Notification ---
NOTIFICATION_HTTP_ADDR=:8086
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Telegram/notif opsional ---
# Isi TELEGRAM_BOT_TOKEN dan TELEGRAM_ADMIN_CHAT_ID untuk M4.
