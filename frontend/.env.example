# Base URL API gateway. Default '/api/v1' memakai proxy Vite (same-origin).
VITE_API_BASE_URL=/api/v1

# Target proxy dev Vite (backend gateway).
VITE_PROXY_TARGET=http://localhost:8081

# Instruksi transfer manual (halaman sukses checkout). Selaras dengan BANK_* di .env backend.
VITE_BANK_NAME="BCA"
VITE_BANK_ACCOUNT="1234567890"
VITE_BANK_HOLDER="Saybu Buah & Sayur"
